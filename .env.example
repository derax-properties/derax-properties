# ---------------------------------------------------------------------------
# Supabase (required)
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API. Run supabase/schema.sql and supabase/policies.sql
# in the SQL editor before first use.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket names (create these as PRIVATE buckets in Supabase Storage)
SUPABASE_SELLER_PHOTOS_BUCKET=seller-photos
SUPABASE_SELLER_DOCS_BUCKET=seller-documents
SUPABASE_PROPERTY_PHOTOS_BUCKET=property-photos

# ---------------------------------------------------------------------------
# Email notifications (optional but recommended)
# Create a free account at https://resend.com to enable email notifications.
# If left blank, submissions still save to the database, emails are skipped.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL=info@deraxproperties.com
EMAIL_FROM="Derax Properties <notifications@deraxproperties.com>"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.deraxproperties.com
NEXT_PUBLIC_COMPANY_PHONE="(XXX) XXX-XXXX"
