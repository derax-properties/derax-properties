# ---------------------------------------------------------------------------
# Supabase (required)
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API. Run supabase/schema.sql and supabase/policies.sql
# in the SQL editor before first use.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket names (create these as PRIVATE buckets in Supabase Storage)
SUPABASE_SELLER_PHOTOS_BUCKET=seller-photos
SUPABASE_SELLER_DOCS_BUCKET=seller-documents
SUPABASE_PROPERTY_PHOTOS_BUCKET=property-photos
# Generated contracts/PDFs (Purchase Agreements, Deal Summaries, Buyer Packages)
SUPABASE_GENERATED_DOCS_BUCKET=generated-documents

# ---------------------------------------------------------------------------
# Email notifications (optional but recommended)
# Create a free account at https://resend.com to enable email notifications.
# If left blank, submissions still save to the database, emails are skipped.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL=info@deraxproperties.com
EMAIL_FROM="Derax Properties <notifications@deraxproperties.com>"

# ---------------------------------------------------------------------------
# Scheduled daily follow-up digest (optional but recommended)
# Vercel Cron calls /api/cron/daily-followups once a day (see vercel.json)
# and sends this as a Bearer token so no one else can trigger it. Set any
# long random string here AND as an env var in your Vercel project — Vercel
# then adds it to the cron request automatically.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI Repair Estimate (optional — the "Estimate with AI" button on a lead's
# Repair Estimate Breakdown). Get a key at https://console.anthropic.com —
# this is a paid API, but each estimate is a single short request (a few
# cents at most). Leave blank and the button just shows an error instead of
# a fabricated number; nothing else in the CRM depends on this key.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional override — defaults to a "-latest" alias that stays current.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.deraxproperties.com
NEXT_PUBLIC_COMPANY_PHONE="(XXX) XXX-XXXX"
